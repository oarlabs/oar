# ==========================================================================
# kit.config — THE KIT'S OWN CONFIG, and a worked example of one
# ==========================================================================
# This file is COMMITTED. `kit.config.example` is the annotated registry of
# every slot; this is a real, filled-in one — the kit uses the kit.
#
# THE SPLIT, AND WHY IT EXISTS
# ----------------------------
# A config that is not in the repo is a config the hook does not find, and a
# rule the hook does not find is a rule that silently stops existing. So the
# config must travel with the tree.
#
# But a config full of one machine's absolute paths is wrong for everybody
# else who clones, and is a small privacy leak besides. So:
#
#     kit.config        COMMITTED   — repo-relative, shareable values
#     kit.config.local  GITIGNORED  — absolute paths, the protected location,
#                                     anything true only on this machine
#
# Both are read from the same directory, `.local` last, later wins. Copy
# `kit.config.local.example` to `kit.config.local` and edit that for anything
# machine-specific.
#
# Search order used by the hook, the fixture harness and the verify runner:
#     1. $KIT_CONFIG
#     2. ./kit.config                  (current working directory)
#     3. <tool's dir>/kit.config
#     4. the nearest kit.config walking UP from the tool's directory
# ==========================================================================

PROJECT_NAME = OAR

# Relative on purpose. The tools resolve the real root by walking up to .git;
# this value is only the FALLBACK when there is no .git ancestor. Put an
# absolute path in kit.config.local if you work outside a git checkout.
PROJECT_ROOT = .

KNOWLEDGE_DIR = NONE
REPORTS_DIR = docs/reports
LEDGERS_DIR = docs
CHECKPOINT_GLOB = docs/CHECKPOINT-*.md

# --- tiers -----------------------------------------------------------------
# Generic names: the kit must not assume one vendor's model line-up. Replace
# with the identifiers your harness actually accepts.
ORCHESTRATOR_TIER = orchestrator-tier
LANE_TIER = lane-tier
SWEEP_TIER = sweep-tier
MODEL_EXEMPT_TYPES = fork
FORBIDDEN_SPAWN_TIER = orchestrator-tier

# --- certification ---------------------------------------------------------
GATE_COMMAND = python modules/03-verification/verify.py
VERIFY_RUNNER = modules/03-verification/verify.py

# Named FILES, not directories. See the note above JUDGE_PATHS in the runner:
# "tools" is the tempting value and it sweeps in cosmetics.
# `kit.config` lists ITSELF, deliberately: the config that parameterises
# the judges is itself a judge. Leaving it out let an uncommitted
# FORBIDDEN_SPAWN_TIER edit ride through a clean PASS.
JUDGE_PATHS = modules/03-verification/verify.py, modules/03-verification/examples, modules/02-enforcement/hook_model_gate.py, modules/02-enforcement/hook_fixtures.py, .claude/settings.json, kit.config, checks-registry.json
CERT_PATHS = modules/03-verification/examples

TOOLCHAIN_NAME = python
TOOLCHAIN_VERSION_CMD = python --version
TOOLCHAIN_PIN = 3.12
PYTHON_MIN = 3.10
VERIFY_OUT_DIR = NONE

# --- the protected-path tripwire -------------------------------------------
# DISABLED, because the kit has nothing to protect - and because its own
# QUICKSTART Step 1 tells adopters to leave it off until they know what it is
# guarding. Shipping it ON so the fixture count looked better meant the kit's
# own smoke never walked its own advice, which is exactly the sort of quiet
# self-exemption this whole apparatus exists to prevent.
#
# With it off, fixtures l and m report `n/a (tripwire disabled by config)` -
# counted and printed, but not a gap, because there is no untested surface
# behind a feature that is off on purpose.
#
# When you turn it on, PROTECTED_PATH is an absolute path to something on YOUR
# machine, so it belongs in kit.config.local, not here.
PROTECTED_PATH_ENABLED = false
PROTECTED_PATH = NONE
CERT_TOKEN_FILE = .claude/cert-green.json

# --- harness ---------------------------------------------------------------
PYTHON_BIN = python
STATUSLINE_CMD = NONE

# --- status board ----------------------------------------------------------
STATUS_BAR_CELLS = 16
STATUS_CLEAR_MARK_PCT = 75
SIDEQUEST_STALE_DAYS = 3
SIDEQUEST_FLAG = .claude/sidequest.json
STATUS_BOARD_LINE_FILE = NONE
AGENT_TRANSCRIPT_DIR = NONE

# --- CI --------------------------------------------------------------------
CI_RUNNER_OS = ubuntu-latest
CI_TIMEOUT_MINUTES = 20
CI_SKIP_GATES = NONE
CI_EXPECTED_EXIT = 0
CI_TOOLCHAIN_URL = NONE
CI_TOOLCHAIN_ARCHIVE = NONE
CI_TOOLCHAIN_SHA512 = NONE
CI_ARTIFACT_RETENTION_DAYS = 14

# --- cost ------------------------------------------------------------------
RATIO_CEILING = derive-from-your-own-data
DEMOTION_REVIEW_STAGES = 3

# --- vocabulary ------------------------------------------------------------
OWNER_ROLE = the owner
COORDINATOR_ROLE = the coordinator

# --- writing standard ------------------------------------------------------
PROSE_VOICE = technical
